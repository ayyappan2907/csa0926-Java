    private void initDatabaseConnection() {
        String[] possiblePasswords = {"root", "", "admin", "password", "123456", "1234"};
        boolean connected = false;

        for (String pwd : possiblePasswords) {
            try {
                conn = DriverManager.getConnection(
                        "jdbc:mysql://" + DB_HOST + ":" + DB_PORT + "/?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC",
                        DB_USER, pwd);
                dbPassword = pwd;
                connected = true;
                break;
            } catch (SQLException ignored) {
            }
        }

        if (!connected) {
            String entered = JOptionPane.showInputDialog(this,
                    "Enter MySQL root password (leave blank if none):",
                    "MySQL Connection", JOptionPane.QUESTION_MESSAGE);
            if (entered != null) {
                try {
                    conn = DriverManager.getConnection(
                            "jdbc:mysql://" + DB_HOST + ":" + DB_PORT + "/?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC",
                            DB_USER, entered);
                    dbPassword = entered;
                    connected = true;
                } catch (SQLException ex) {
                    JOptionPane.showMessageDialog(this, "Failed to connect to MySQL: " + ex.getMessage(), "Database Error", JOptionPane.ERROR_MESSAGE);
                }
            }
        }

        if (connected) {
            setupTablesAndSeed();
        }
    }

    private void setupTablesAndSeed() {
        try (Statement stmt = conn.createStatement()) {
            stmt.executeUpdate("CREATE DATABASE IF NOT EXISTS " + DB_NAME);
            stmt.executeUpdate("USE " + DB_NAME);

            // Table 1: members
            stmt.executeUpdate("CREATE TABLE IF NOT EXISTS members ("
                    + "member_id INT AUTO_INCREMENT PRIMARY KEY, "
                    + "name VARCHAR(100) NOT NULL, "
                    + "email VARCHAR(100)"
                    + ");");

            // Table 2: books with Foreign Key relationship to members
            stmt.executeUpdate("CREATE TABLE IF NOT EXISTS books ("
                    + "book_id INT AUTO_INCREMENT PRIMARY KEY, "
                    + "title VARCHAR(150) NOT NULL, "
                    + "author VARCHAR(100) NOT NULL, "
                    + "is_issued BOOLEAN DEFAULT FALSE, "
                    + "issued_to INT DEFAULT NULL, "
                    + "CONSTRAINT fk_issued_to FOREIGN KEY (issued_to) REFERENCES members(member_id) ON DELETE SET NULL"
                    + ");");

            // Seed initial members if empty
            ResultSet rsM = stmt.executeQuery("SELECT COUNT(*) FROM members");
            if (rsM.next() && rsM.getInt(1) == 0) {
                stmt.executeUpdate("INSERT INTO members (name, email) VALUES "
                        + "('Ayyappan N', 'ayyappan@example.com'), "
                        + "('Sarah Connor', 'sarah.c@example.com'), "
                        + "('Alan Turing', 'alan.turing@example.com'), "
                        + "('Ada Lovelace', 'ada.lovelace@example.com');");
            }
            rsM.close();

            // Seed initial books if empty
            ResultSet rsB = stmt.executeQuery("SELECT COUNT(*) FROM books");
            if (rsB.next() && rsB.getInt(1) == 0) {
                stmt.executeUpdate("INSERT INTO books (title, author, is_issued, issued_to) VALUES "
                        + "('Clean Code: A Handbook of Agile Software Craftsmanship', 'Robert C. Martin', FALSE, NULL), "
                        + "('Effective Java (3rd Edition)', 'Joshua Bloch', FALSE, NULL), "
                        + "('Design Patterns: Elements of Reusable Object-Oriented Software', 'Erich Gamma et al.', FALSE, NULL), "
                        + "('Introduction to Algorithms', 'Thomas H. Cormen', FALSE, NULL), "
                        + "('The Pragmatic Programmer', 'Andrew Hunt & David Thomas', FALSE, NULL), "
                        + "('Java: The Complete Reference', 'Herbert Schildt', FALSE, NULL);");
            }
            rsB.close();
        } catch (SQLException e) {
            System.err.println("[Database Init Error] " + e.getMessage());
        }
    }

