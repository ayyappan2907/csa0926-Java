    public void refreshAllData() {
        loadCatalogData(null);
        loadJoinReportData();
        loadMembersData();
    }

    private void loadCatalogData(String searchKeyword) {
        catalogModel.setRowCount(0);
        if (conn == null) return;

        String query = (searchKeyword == null || searchKeyword.trim().isEmpty())
                ? "SELECT b.book_id, b.title, b.author, b.is_issued, m.name AS member_name FROM books b LEFT JOIN members m ON b.issued_to = m.member_id ORDER BY b.book_id ASC;"
                : "SELECT b.book_id, b.title, b.author, b.is_issued, m.name AS member_name FROM books b LEFT JOIN members m ON b.issued_to = m.member_id WHERE LOWER(b.title) LIKE ? OR LOWER(b.author) LIKE ? ORDER BY b.book_id ASC;";

        try (PreparedStatement pstmt = conn.prepareStatement(query)) {
            if (searchKeyword != null && !searchKeyword.trim().isEmpty()) {
                String wildcard = "%" + searchKeyword.trim().toLowerCase() + "%";
                pstmt.setString(1, wildcard);
                pstmt.setString(2, wildcard);
            }

            try (ResultSet rs = pstmt.executeQuery()) {
                while (rs.next()) {
                    int id = rs.getInt("book_id");
                    String title = rs.getString("title");
                    String author = rs.getString("author");
                    boolean isIssued = rs.getBoolean("is_issued");
                    String memberName = rs.getString("member_name");
                    catalogModel.addRow(new Object[]{id, title, author, isIssued ? "ISSUED" : "AVAILABLE", (isIssued && memberName != null) ? memberName : "-"});
                }
            }
        } catch (SQLException e) {
            logTransaction("[Catalog Error] " + e.getMessage());
        }
    }

    private void performSearch(String keyword) {
        if (keyword.isEmpty()) {
            loadCatalogData(null);
        } else {
            loadCatalogData(keyword);
            logTransaction("[Search Executed] Keyword: '" + keyword + "' (PreparedStatement LIKE)");
        }
    }

    private void loadJoinReportData() {
        joinModel.setRowCount(0);
        if (conn == null) return;

        // SQL INNER JOIN Demonstration
        String joinSQL = "SELECT b.book_id, b.title, b.author, m.member_id, m.name AS member_name, m.email AS member_email "
                + "FROM books b "
                + "INNER JOIN members m ON b.issued_to = m.member_id "
                + "WHERE b.is_issued = TRUE "
                + "ORDER BY b.book_id ASC;";

        int count = 0;
        try (PreparedStatement pstmt = conn.prepareStatement(joinSQL);
             ResultSet rs = pstmt.executeQuery()) {

            while (rs.next()) {
                count++;
                joinModel.addRow(new Object[]{
                        rs.getInt("book_id"),
                        rs.getString("title"),
                        rs.getString("author"),
                        rs.getInt("member_id"),
                        rs.getString("member_name"),
                        rs.getString("member_email") != null ? rs.getString("member_email") : "-"
                });
            }

            if (totalIssuedBadge != null) {
                totalIssuedBadge.setText("Currently Issued: " + count + " book" + (count == 1 ? "" : "s"));
            }
        } catch (SQLException e) {
            logTransaction("[JOIN Report Error] " + e.getMessage());
        }
    }

    private void loadMembersData() {
        membersModel.setRowCount(0);
        if (conn == null) return;

        String query = "SELECT member_id, name, email FROM members ORDER BY member_id ASC;";
        try (PreparedStatement pstmt = conn.prepareStatement(query);
             ResultSet rs = pstmt.executeQuery()) {
            while (rs.next()) {
                membersModel.addRow(new Object[]{
                        rs.getInt("member_id"),
                        rs.getString("name"),
                        rs.getString("email") != null ? rs.getString("email") : "-"
                });
            }
        } catch (SQLException e) {
            logTransaction("[Members Error] " + e.getMessage());
        }
    }

